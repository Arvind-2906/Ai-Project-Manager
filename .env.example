# -----------------------------------------------------------------------------
# AI Project Manager - Root Environment Variables Template
# -----------------------------------------------------------------------------

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth Configuration
BETTER_AUTH_SECRET=your_super_secret_auth_key_replace_in_production_min_32_chars
BETTER_AUTH_URL=http://localhost:3000

# Neon PostgreSQL Database (pgvector enabled)
# Example Neon Connection URI: postgresql://user:password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_project_manager?schema=public

# Redis Connection (Cache & Queue)
REDIS_URL=redis://localhost:6379

# AI Backend Fast-API Service Endpoint
AI_BACKEND_URL=http://localhost:8000
AI_INTERNAL_SECRET_KEY=internal_agent_secret_key_change_me

# Google Gemini API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro-latest
GEMINI_EMBEDDING_MODEL=text-embedding-004

# GitHub Integration (Optional - for Code Review & Repo Sync)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
