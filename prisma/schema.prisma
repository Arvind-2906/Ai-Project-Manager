// Prisma schema for AI Project Manager
// Database: Neon PostgreSQL with pgvector extension enabled

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// -----------------------------------------------------------------------------
// Better Auth Core Models
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(ENGINEER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  memberships   OrganizationMember[]
  assignedTasks Task[]               @relation("TaskAssignee")
  comments      Comment[]
  actionApprovals ActionProposal[]   @relation("ApprovedByUser")
  auditLogs     AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF_ENGINEER
  ENGINEER
  VIEWER
}

// -----------------------------------------------------------------------------
// Organization & Team Entities
// -----------------------------------------------------------------------------

model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  members     OrganizationMember[]
  projects    Project[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole     @default(ENGINEER)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

// -----------------------------------------------------------------------------
// Project & Semantic RAG Entities (pgvector)
// -----------------------------------------------------------------------------

model Project {
  id             String              @id @default(cuid())
  name           String
  key            String              @unique // e.g. "DCE"
  description    String?
  organizationId String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sprints        Sprint[]
  tasks          Task[]
  risks          Risk[]
  embeddings     DocumentEmbedding[]
  agentRuns      AgentRun[]
  actionProposals ActionProposal[]

  @@map("projects")
}

model DocumentEmbedding {
  id         String                 @id @default(cuid())
  projectId  String
  sourceType String                 // PRD, ARCHITECTURE, TASK, CODE_DIFF
  sourceId   String?
  content    String                 @db.Text
  embedding  Unsupported("vector(768)")? // Gemini text-embedding-004 vector
  metadata   Json?
  createdAt  DateTime               @default(now())

  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("document_embeddings")
}

// -----------------------------------------------------------------------------
// SDLC & Task Management Entities
// -----------------------------------------------------------------------------

model Sprint {
  id              String       @id @default(cuid())
  name            String
  goal            String?
  projectId       String
  status          SprintStatus @default(PLANNED)
  startDate       DateTime?
  endDate         DateTime?
  capacityPoints  Int          @default(30)
  committedPoints Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks           Task[]

  @@map("sprints")
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Task {
  id             String           @id @default(cuid())
  title          String
  description    String?          @db.Text
  status         TaskStatus       @default(BACKLOG)
  priority       TaskPriority     @default(MEDIUM)
  points         Int              @default(3)
  projectId      String
  sprintId       String?
  assigneeId     String?
  agentGenerated Boolean          @default(false)
  acceptanceCriteria Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint         Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee       User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dependencies   TaskDependency[] @relation("SourceTask")
  dependents     TaskDependency[] @relation("TargetTask")
  comments       Comment[]

  @@map("tasks")
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model TaskDependency {
  id           String         @id @default(cuid())
  sourceTaskId String
  targetTaskId String
  type         DependencyType @default(BLOCKS)
  createdAt    DateTime       @default(now())

  sourceTask   Task           @relation("SourceTask", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTask   Task           @relation("TargetTask", fields: [targetTaskId], references: [id], onDelete: Cascade)

  @@unique([sourceTaskId, targetTaskId])
  @@map("task_dependencies")
}

enum DependencyType {
  BLOCKS
  RELIES_ON
  RELATED
}

// -----------------------------------------------------------------------------
// Risk Management & Discussions
// -----------------------------------------------------------------------------

model Risk {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  severity    RiskSeverity  @default(MEDIUM)
  likelihood  RiskLikelihood @default(MEDIUM)
  mitigation  String?       @db.Text
  projectId   String
  agentDetected String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("risks")
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskLikelihood {
  LOW
  MEDIUM
  HIGH
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  taskId    String
  authorId  String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}

// -----------------------------------------------------------------------------
// Agent Execution & Human-in-the-Loop Governance
// -----------------------------------------------------------------------------

model AgentRun {
  id             String          @id @default(cuid())
  workflowType   String          // PROJECT_CREATION, SPRINT_PLANNING, RISK_MONITORING, CODE_REVIEW
  projectId      String
  agentName      String          // SUPERVISOR, PRODUCT, TASK, DEPENDENCY, etc.
  status         AgentRunStatus  @default(RUNNING)
  inputPayload   Json?
  outputPayload  Json?
  tokensUsed     Int             @default(0)
  startedAt      DateTime        @default(now())
  completedAt    DateTime?

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposals      ActionProposal[]

  @@map("agent_runs")
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
  AWAITING_HUMAN_APPROVAL
}

model ActionProposal {
  id             String         @id @default(cuid())
  agentRunId     String
  projectId      String
  actionType     String         // CREATE_TASK, UPDATE_SPRINT, CREATE_DEPENDENCY, CREATE_RISK
  description    String         @db.Text
  proposedData   Json
  confidence     Float          @default(0.9)
  status         ProposalStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  rejectionReason String?
  createdAt      DateTime       @default(now())

  agentRun       AgentRun       @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewedBy     User?          @relation("ApprovedByUser", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@map("action_proposals")
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
