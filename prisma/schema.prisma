// Prisma schema for AI-Powered Project Manager
// Database: Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// User & Authentication Models (Better Auth Compatible)
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]

  organizationMemberships OrganizationMember[]
  projectMemberships     ProjectMember[]
  createdProjects        Project[]            @relation("ProjectCreator")
  assignedTasks          Task[]               @relation("TaskAssignee")
  reportedTasks          Task[]               @relation("TaskReporter")
  userStories            UserStory[]          @relation("UserStoryAssignee")
  ownedRisks             Risk[]               @relation("RiskOwner")
  assignedRiskActions    RiskAction[]         @relation("RiskActionAssignee")
  comments               Comment[]
  activityLogs           ActivityLog[]
  notifications          Notification[]
  requestedApprovals     Approval[]           @relation("ApprovalRequester")
  reviewedApprovals      Approval[]           @relation("ApprovalReviewer")
  uploadedDocuments      Document[]           @relation("DocumentUploader")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// -----------------------------------------------------------------------------
// Organization & Contextual Membership
// -----------------------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  projects    Project[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

enum OrganizationRole {
  OWNER
  ADMIN
  PROJECT_MANAGER
  MEMBER
  VIEWER
}

// -----------------------------------------------------------------------------
// Project & Project Membership
// -----------------------------------------------------------------------------

model Project {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  key            String        @unique
  description    String?       @db.Text
  status         ProjectStatus @default(PLANNING)
  startDate      DateTime?
  targetDate     DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?         @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members        ProjectMember[]
  requirements   Requirement[]
  epics          Epic[]
  tasks          Task[]
  sprints        Sprint[]
  dependencies   Dependency[]
  risks          Risk[]
  comments       Comment[]
  activityLogs   ActivityLog[]
  notifications  Notification[]
  agents         Agent[]
  agentRuns      AgentRun[]
  approvals      Approval[]
  documents      Document[]

  @@index([organizationId])
  @@index([createdById])
  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(DEVELOPER)
  joinedAt  DateTime    @default(now())

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

enum ProjectRole {
  PROJECT_MANAGER
  DEVELOPER
  DESIGNER
  TESTER
  VIEWER
}

// -----------------------------------------------------------------------------
// Requirements (PRD & System Specifications)
// -----------------------------------------------------------------------------

model Requirement {
  id                 String              @id @default(cuid())
  projectId          String
  title              String
  description        String?             @db.Text
  type               RequirementType     @default(FUNCTIONAL)
  priority           RequirementPriority @default(MEDIUM)
  status             RequirementStatus   @default(DRAFT)
  acceptanceCriteria Json?
  businessGoal       String?             @db.Text
  constraints        Json?
  source             String?
  version            Int                 @default(1)
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("requirements")
}

enum RequirementType {
  FUNCTIONAL
  NON_FUNCTIONAL
  BUSINESS
  TECHNICAL
}

enum RequirementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// -----------------------------------------------------------------------------
// Project Hierarchy: Epic -> Feature -> UserStory -> Task (with Subtasks)
// -----------------------------------------------------------------------------

model Epic {
  id          String       @id @default(cuid())
  projectId   String
  title       String
  description String?      @db.Text
  status      EpicStatus   @default(PLANNED)
  priority    TaskPriority @default(MEDIUM)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features    Feature[]

  @@index([projectId])
  @@map("epics")
}

enum EpicStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Feature {
  id          String        @id @default(cuid())
  epicId      String
  title       String
  description String?       @db.Text
  status      FeatureStatus @default(PLANNED)
  priority    TaskPriority  @default(MEDIUM)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  epic        Epic          @relation(fields: [epicId], references: [id], onDelete: Cascade)
  userStories UserStory[]

  @@index([epicId])
  @@map("features")
}

enum FeatureStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model UserStory {
  id                 String          @id @default(cuid())
  featureId          String
  title              String
  description        String?         @db.Text
  acceptanceCriteria Json?
  priority           TaskPriority    @default(MEDIUM)
  status             UserStoryStatus @default(BACKLOG)
  storyPoints        Int?
  assigneeId         String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  feature            Feature         @relation(fields: [featureId], references: [id], onDelete: Cascade)
  assignee           User?           @relation("UserStoryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  tasks              Task[]

  @@index([featureId])
  @@index([assigneeId])
  @@map("user_stories")
}

enum UserStoryStatus {
  BACKLOG
  READY
  IN_PROGRESS
  DONE
}

model Task {
  id             String       @id @default(cuid())
  projectId      String
  userStoryId    String?
  parentTaskId   String?
  title          String
  description    String?      @db.Text
  status         TaskStatus   @default(BACKLOG)
  priority       TaskPriority @default(MEDIUM)
  type           TaskType     @default(TASK)
  assigneeId     String?
  reporterId     String?
  storyPoints    Int?         @default(3)
  estimatedHours Float?
  actualHours    Float?
  dueDate        DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userStory      UserStory?   @relation(fields: [userStoryId], references: [id], onDelete: SetNull)

  parentTask     Task?        @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks       Task[]       @relation("TaskSubtasks")

  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter       User?        @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  sprintTasks    SprintTask[]
  outgoingDependencies Dependency[] @relation("SourceTaskDependency")
  incomingDependencies Dependency[] @relation("TargetTaskDependency")
  comments       Comment[]

  @@index([projectId])
  @@index([userStoryId])
  @@index([parentTaskId])
  @@index([assigneeId])
  @@index([status])
  @@map("tasks")
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  TESTING
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  FEATURE
  BUG
  TASK
  REFACTOR
  DOCUMENTATION
  TEST
}

// -----------------------------------------------------------------------------
// Sprint & Sprint Tasks
// -----------------------------------------------------------------------------

model Sprint {
  id          String       @id @default(cuid())
  projectId   String
  name        String
  goal        String?      @db.Text
  status      SprintStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  capacity    Int          @default(30)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintTasks SprintTask[]

  @@index([projectId])
  @@index([status])
  @@map("sprints")
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

model SprintTask {
  id        String   @id @default(cuid())
  sprintId  String
  taskId    String
  addedAt   DateTime @default(now())

  sprint    Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([sprintId, taskId])
  @@index([sprintId])
  @@index([taskId])
  @@map("sprint_tasks")
}

// -----------------------------------------------------------------------------
// Task Dependencies (Directed Graph)
// -----------------------------------------------------------------------------

model Dependency {
  id           String         @id @default(cuid())
  projectId    String
  sourceTaskId String
  targetTaskId String
  type         DependencyType @default(BLOCKS)
  createdById  String?
  createdAt    DateTime       @default(now())

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceTask   Task           @relation("SourceTaskDependency", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTask   Task           @relation("TargetTaskDependency", fields: [targetTaskId], references: [id], onDelete: Cascade)

  @@unique([sourceTaskId, targetTaskId])
  @@index([projectId])
  @@index([sourceTaskId])
  @@index([targetTaskId])
  @@map("dependencies")
}

enum DependencyType {
  BLOCKS
  BLOCKED_BY
  RELATES_TO
}

// -----------------------------------------------------------------------------
// Risk Management & Actions
// -----------------------------------------------------------------------------

model Risk {
  id          String         @id @default(cuid())
  projectId   String
  title       String
  description String?        @db.Text
  severity    RiskSeverity   @default(MEDIUM)
  probability Float          @default(0.5)
  impact      Float          @default(0.5)
  status      RiskStatus     @default(OPEN)
  detectedBy  String?
  ownerId     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?          @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  actions     RiskAction[]

  @@index([projectId])
  @@index([severity])
  @@index([status])
  @@map("risks")
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MITIGATING
  RESOLVED
  ACCEPTED
  CLOSED
}

model RiskAction {
  id           String           @id @default(cuid())
  riskId       String
  description  String           @db.Text
  status       RiskActionStatus @default(PENDING)
  assignedToId String?
  dueDate      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  risk         Risk             @relation(fields: [riskId], references: [id], onDelete: Cascade)
  assignedTo   User?            @relation("RiskActionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([riskId])
  @@map("risk_actions")
}

enum RiskActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// -----------------------------------------------------------------------------
// AI Agents & Execution Runs
// -----------------------------------------------------------------------------

model Agent {
  id          String    @id @default(cuid())
  projectId   String
  type        AgentType
  name        String
  description String?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRuns   AgentRun[]

  @@index([projectId])
  @@map("agents")
}

enum AgentType {
  SUPERVISOR
  PRODUCT
  TASK
  SPRINT
  RISK
  DEVELOPER
  CODE_REVIEW
  STANDUP
}

model AgentRun {
  id            String         @id @default(cuid())
  agentId       String
  projectId     String
  workflowId    String
  status        AgentRunStatus @default(PENDING)
  input         Json?
  output        Json?
  error         String?        @db.Text
  startedAt     DateTime       @default(now())
  completedAt   DateTime?
  tokenUsage    Int?           @default(0)
  executionTime Float?

  agent         Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvals     Approval[]

  @@index([agentId])
  @@index([projectId])
  @@index([workflowId])
  @@map("agent_runs")
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// -----------------------------------------------------------------------------
// Human-in-the-Loop Approvals
// -----------------------------------------------------------------------------

model Approval {
  id              String         @id @default(cuid())
  projectId       String
  agentRunId      String?
  requestedById   String?
  actionType      String
  payload         Json
  status          ApprovalStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?        @db.Text
  createdAt       DateTime       @default(now())

  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRun        AgentRun?      @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  requestedBy     User?          @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy      User?          @relation("ApprovalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@map("approvals")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// -----------------------------------------------------------------------------
// Comments, Activity Log, and Notifications
// -----------------------------------------------------------------------------

model Comment {
  id        String   @id @default(cuid())
  projectId String
  taskId    String?
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([taskId])
  @@index([userId])
  @@map("comments")
}

model ActivityLog {
  id         String    @id @default(cuid())
  projectId  String
  userId     String?
  actorType  ActorType @default(USER)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime  @default(now())

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

enum ActorType {
  USER
  AGENT
  SYSTEM
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  type      String
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// Documents (RAG Readiness)
// -----------------------------------------------------------------------------

model Document {
  id           String          @id @default(cuid())
  projectId    String
  name         String
  type         String
  storageUrl   String?
  uploadedById String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User?           @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  chunks       DocumentChunk[]

  @@index([projectId])
  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String   @db.Text
  chunkIndex Int
  embedding  String?  @db.Text
  metadata   Json?

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_chunks")
}
