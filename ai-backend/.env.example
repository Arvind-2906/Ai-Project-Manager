# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro-latest
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Next.js Backend Endpoint & Internal Secret
NEXTJS_BACKEND_URL=http://localhost:3000
INTERNAL_SECRET_KEY=internal_agent_secret_key_change_me

# Redis Queue & State Persistence
REDIS_URL=redis://localhost:6379

# Neon PostgreSQL with pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_project_manager

# Service Port
PORT=8000
HOST=0.0.0.0
DEBUG=True
